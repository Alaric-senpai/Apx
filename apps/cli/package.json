{
  "name": "apx",
  "version": "0.1.0",
  "description": "Offline-first scaffolding and project manager for JavaScript and TypeScript frameworks",
  "bin": {
    "apx": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "offline",
    "scaffold",
    "pnpm",
    "nextjs",
    "vite",
    "typescript",
    "starter"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@apx/commands": "workspace:*",
    "@apx/core": "workspace:*",
    "@apx/types": "workspace:*",
    "@apx/utils": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
